# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Ambiente local: execute `supabase status` e use "API URL" e "Publishable key" (ou "anon key").
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# NUNCA coloque a service_role / secret key em variáveis VITE_*: tudo que começa
# com VITE_ vai para o navegador. A chave secreta é usada somente nos testes de
# API (arquivo .env.test.local, fora do controle de versão).
